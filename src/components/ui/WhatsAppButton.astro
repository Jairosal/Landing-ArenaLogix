---
/** 
 * ✏️  CAMBIA AQUÍ TU NÚMERO DE WHATSAPP (con código de país, sin + ni espacios):
 */
const WHATSAPP_NUMBER = "521234567890";

const WHATSAPP_MESSAGE =
    "Hola, me gustaría obtener más información sobre sus servicios.";

const whatsappUrl = `https://wa.me/${WHATSAPP_NUMBER}${WHATSAPP_MESSAGE ? `?text=${encodeURIComponent(WHATSAPP_MESSAGE)}` : ""}`;
---

<a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Chatea con nosotros por WhatsApp"
    id="whatsapp-float"
    class="fixed bottom-6 right-6 z-50
         flex items-center justify-center
         w-14 h-14 md:w-16 md:h-16
         md:bottom-8 md:right-8
         rounded-full bg-[#25d366] text-white
         shadow-[0_4px_14px_rgba(37,211,102,0.45),0_2px_6px_rgba(0,0,0,0.15)]
         hover:scale-110 hover:shadow-[0_6px_20px_rgba(37,211,102,0.55),0_4px_10px_rgba(0,0,0,0.2)]
         active:scale-105
         transition-all duration-250 ease-out
         animate-wa-pulse
         no-underline"
>
    <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 32 32"
        fill="currentColor"
        class="w-7 h-7 md:w-8 md:h-8"
        aria-hidden="true"
    >
        <path
            d="M16.004 0h-.008C7.174 0 0 7.176 0 16.004c0 3.5 1.132 6.745 3.058 9.387L1.058 31.22l6.06-1.94a15.91 15.91 0 008.886 2.684C24.826 31.964 32 24.83 32 16.004 32 7.176 24.826 0 16.004 0zm9.316 22.61c-.39 1.1-2.276 2.1-3.176 2.17-.86.066-1.67.39-5.63-1.17-4.78-1.88-7.82-6.8-8.06-7.12-.23-.32-1.9-2.53-1.9-4.83s1.2-3.43 1.63-3.9c.43-.47.93-.59 1.24-.59.31 0 .62.003.89.016.29.013.67-.11 1.05.8.39.93 1.33 3.24 1.44 3.48.12.23.2.51.04.82-.16.32-.24.51-.47.79-.24.27-.5.61-.71.82-.24.23-.48.48-.21.94.28.47 1.24 2.04 2.66 3.31 1.82 1.63 3.36 2.13 3.84 2.37.47.24.75.2 1.03-.12.27-.32 1.17-1.37 1.49-1.84.31-.47.63-.39 1.06-.23.43.16 2.74 1.29 3.21 1.53.47.23.78.35.9.55.12.19.12 1.12-.28 2.21z"
        ></path>
    </svg>
</a>

<style>
    /* Animación personalizada de pulse para el brillo verde */
    @keyframes wa-pulse {
        0%,
        100% {
            box-shadow:
                0 4px 14px rgba(37, 211, 102, 0.45),
                0 2px 6px rgba(0, 0, 0, 0.15);
        }
        50% {
            box-shadow:
                0 4px 22px rgba(37, 211, 102, 0.65),
                0 2px 10px rgba(0, 0, 0, 0.2);
        }
    }

    .animate-wa-pulse {
        animation: wa-pulse 2s ease-in-out infinite;
    }

    .animate-wa-pulse:hover {
        animation: none;
    }
</style>
