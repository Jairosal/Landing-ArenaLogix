---
import Button from "../ui/Button.astro";
import Card from "../ui/Card.astro";
import { Image } from "astro:assets";
import recurso1 from "../../assets/Recurso 1.png";
import recurso9 from "../../assets/Recurso 9.png";
import pcIlust from "../../assets/pc-ilust.png";
import recurso11 from "../../assets/Recurso 11.png";
import recurso12 from "../../assets/Recurso 12.png";
import phoneIlust from "../../assets/phone-ilust.png";
import personaIlust from "../../assets/persona-ilust.png";

const cards = [
  {
    image: recurso9,
    text: "Desarrollamos e implementamos soluciones basadas en la nube que ofrecen flexibilidad, escalabilidad y accesibilidad, permitiendo a las organizaciones reducir costos y optimizar sus operaciones de forma segura.",
  },
  {
    image: pcIlust,
    text: "Ayudamos a las empresas a automatizar tareas repetitivas y procesos complejos, utilizando soluciones de software que mejoren la eficiencia operativa y liberen recursos para tareas de mayor valor.",
  },
  {
    image: recurso11,
    text: "Creamos soluciones de software a medida, adaptadas específicamente a las necesidades de cada cliente, optimizando sus procesos y mejorando su competitividad en el mercado.",
  },
  {
    image: recurso12,
    text: "Proporcionamos soporte técnico y mantenimiento preventivo para garantizar que las soluciones implementadas sigan funcionando de manera óptima, asegurando la continuidad y seguridad del negocio.",
  },
  {
    image: phoneIlust,
    text: "Desarrollamos aplicaciones web y móviles intuitivas, escalables y seguras, que permiten a las empresas mejorar la interacción con sus usuarios y optimizar sus operaciones diarias.",
  },
  {
    image: personaIlust,
    text: "Proporcionamos asesoramiento experto para ayudar a las empresas a identificar las mejores soluciones tecnológicas y estrategias digitales, asegurando que su infraestructura y aplicaciones estén alineados con sus objetivos a largo plazo.",
  },
];
---

<section
  id="contact"
  class="bg-gray-50 py-16 lg:py-24 font-body overflow-hidden relative"
>
  <div class="absolute inset-0 z-0 pointer-events-none opacity-50">
    <Image
      src={recurso1}
      alt=""
      class="w-full h-full object-cover"
      width={1920}
      format="webp"
    />
  </div>

  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-8 items-center">
      <div class="space-y-10">
        <div class="space-y-0 relative">
          <!-- Marco blanco transparente que se extiende de lado a lado de la pantalla -->
          <div
            class="absolute left-1/2 -translate-x-1/2 w-screen -inset-y-4 sm:-inset-y-6 bg-white/40 backdrop-blur-sm"
          >
          </div>

          <h2
            class="text-3xl lg:text-4xl font-body font-bold leading-none tracking-tight text-gray-900 text-center lg:text-left relative z-10"
          >
            Tu visión, nuestra tecnología,
          </h2>
          <h2
            class="text-3xl lg:text-4xl font-body font-bold leading-none tracking-tight text-gray-900 text-center lg:text-right relative z-10"
          >
            resultados extraordinarios.
          </h2>
        </div>

        <div class="flex flex-col space-y-6 w-full">
          {
            cards.map((card, index) => (
              <Card
                image={card.image}
                title=""
                alternating={true}
                index={index}
              >
                {card.text}
              </Card>
            ))
          }
        </div>
      </div>

      <div class="flex justify-center lg:justify-end">
        <div
          id="cotizar"
          class="flex justify-center lg:justify-end w-full lg:-mt-32 lg:mr-8"
        >
          <div
            class="bg-[#e5f5f7] border border-[#DCEBF6] rounded-[1.5rem] md:rounded-[2rem] p-4 sm:p-6 md:p-8 shadow-[8px_8px_16px_rgba(0,0,0,0.50)] w-full max-w-sm md:max-w-lg relative font-body"
          >
            <h3
              class="text-brand-primary text-xl sm:text-3xl lg:text-4xl font-normal mb-4 sm:mb-6 font-heading"
            >
              Nosotros te llamamos:
            </h3>

            <form
              id="contact-form"
              action="https://api.staticforms.dev/submit"
              method="POST"
              class="space-y-4 sm:space-y-6"
            >
              <!-- Static Forms hidden fields -->
              <input
                type="hidden"
                name="accessKey"
                value="YOUR_ACCESS_KEY_HERE"
              />
              <input
                type="hidden"
                name="subject"
                value="Nuevo contacto desde ArenaLogix"
              />
              <input type="hidden" name="replyTo" value="@" />
              <!-- Honeypot anti-spam -->
              <input type="text" name="honeypot" style="display:none" />
              <div class="border border-white rounded-xl sm:rounded-[1rem] p-2">
                <label
                  class="block text-xs sm:text-sm font-geometr font-bold text-gray-900 mb-1"
                  for="name"
                >
                  Nombre y Apellido:
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  class="w-full bg-transparent border-none focus:outline-none focus:ring-0 px-0 py-1 text-sm sm:text-base text-gray-700"
                />
              </div>

              <div class="border border-white rounded-xl sm:rounded-[1rem] p-2">
                <label
                  class="block text-xs sm:text-sm font-geometr font-bold text-gray-900 mb-1"
                  for="phone"
                >
                  Teléfono:
                </label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  required
                  class="w-full bg-transparent border-none focus:outline-none focus:ring-0 px-0 py-1 text-sm sm:text-base text-gray-700"
                />
              </div>

              <div class="border border-white rounded-xl sm:rounded-[1rem] p-2">
                <label
                  class="block text-xs sm:text-sm font-geometr font-bold text-gray-900 mb-1"
                  for="email"
                >
                  E-Mail:
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  class="w-full bg-transparent border-none focus:outline-none focus:ring-0 px-0 py-1 text-sm sm:text-base text-gray-700"
                />
              </div>

              <!-- Checkbox con texto inline -->
              <div
                class="border border-white rounded-xl sm:rounded-[1rem] p-2 sm:p-3"
              >
                <label
                  for="privacy"
                  class="cursor-pointer text-[10px] sm:text-xs text-gray-900 font-geometr leading-relaxed text-justify block"
                >
                  <input
                    id="privacy"
                    type="checkbox"
                    required
                    class="h-3.5 w-3.5 sm:h-4 sm:w-4 rounded border-2 border-brand-primary accent-brand-primary focus:ring-brand-primary cursor-pointer align-middle mr-1.5 inline-block"
                  />
                  Autorizo expresamente a ArenaLogix para que me contacten y/o envíen
                  información respecto de sus programas de pregrados y otra información
                  de interés, así como la política de privacidad y protección de datos
                  personales del sitio web
                </label>
              </div>

              <div class="pt-1 sm:pt-2">
                <Button
                  type="submit"
                  variant="primary"
                  size="lg"
                  fullWidth={true}
                >
                  Enviar mis datos
                </Button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Modal de confirmación -->
<div
  id="success-modal"
  class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300"
>
  <div
    class="bg-white rounded-2xl shadow-2xl p-8 sm:p-10 max-w-md mx-4 text-center transform scale-95 transition-transform duration-300"
    id="success-modal-content"
  >
    <!-- Ícono de check -->
    <div
      class="w-16 h-16 sm:w-20 sm:h-20 mx-auto mb-4 bg-green-100 rounded-full flex items-center justify-center"
    >
      <svg
        class="w-8 h-8 sm:w-10 sm:h-10 text-green-500"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2.5"
          d="M5 13l4 4L19 7"></path>
      </svg>
    </div>
    <h3 class="text-xl sm:text-2xl font-bold text-gray-900 mb-2 font-heading">
      ¡Datos enviados!
    </h3>
    <p class="text-sm sm:text-base text-gray-600 mb-6 font-body">
      Gracias por tu interés. Nuestro equipo se pondrá en contacto contigo muy
      pronto.
    </p>
    <button
      id="close-modal-btn"
      class="inline-flex items-center justify-center font-bold rounded-full uppercase tracking-wide transition-all duration-300 cursor-pointer bg-brand-primary hover:bg-brand-primary/80 text-white shadow-lg hover:shadow-xl py-2.5 px-8 text-sm"
    >
      Aceptar
    </button>
  </div>
</div>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const modal = document.getElementById("success-modal");
  const modalContent = document.getElementById("success-modal-content");
  const closeBtn = document.getElementById("close-modal-btn");

  function showModal() {
    if (!modal || !modalContent) return;
    modal.classList.remove("opacity-0", "pointer-events-none");
    modal.classList.add("opacity-100");
    modalContent.classList.remove("scale-95");
    modalContent.classList.add("scale-100");
  }

  function hideModal() {
    if (!modal || !modalContent) return;
    modal.classList.add("opacity-0", "pointer-events-none");
    modal.classList.remove("opacity-100");
    modalContent.classList.add("scale-95");
    modalContent.classList.remove("scale-100");
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    const submitBtn = form.querySelector(
      'button[type="submit"]',
    ) as HTMLButtonElement;
    const originalText = submitBtn?.textContent || "";

    try {
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = "Enviando...";
      }

      const formData = new FormData(form);
      const response = await fetch(form.action, {
        method: "POST",
        body: formData,
      });

      if (response.ok) {
        form.reset();
        showModal();
      } else {
        alert(
          "Hubo un error al enviar tus datos. Por favor, intenta de nuevo.",
        );
      }
    } catch {
      alert(
        "Error de conexión. Verifica tu conexión a internet e intenta de nuevo.",
      );
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = originalText;
      }
    }
  });

  closeBtn?.addEventListener("click", hideModal);

  // Cerrar modal al hacer clic fuera del contenido
  modal?.addEventListener("click", (e) => {
    if (e.target === modal) hideModal();
  });

  // Cerrar modal con tecla Escape
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") hideModal();
  });
</script>
